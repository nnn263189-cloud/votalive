# Obrigatório quando NODE_ENV=production.
ADMIN_TOKEN=troque-por-um-segredo-longo-e-aleatorio
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
STATE_FILE=data/state.json
# ALLOWED_ORIGINS=https://seu-dominio.example

# Assinatura da conexão do TikTok (Euler Stream). Sem a chave, o conector usa o
# acesso compartilhado, sujeito a limite e recusa. Crie a chave em
# https://www.eulerstream.com e configure na hospedagem, nunca no Git.
# SIGN_API_KEY=
# Desativa a rota de fallback da Euler Stream para descobrir a sala (opcional).
# TIKTOK_SKIP_EULER_FALLBACK=false
# Catálogo de presentes do conector (enableExtendedGiftInfo). Usa a rota premium
# gift/list/ da Euler Stream (plano Business); sem o plano a conexão falha com
# PremiumFeatureError. O VotaLive não precisa dele: deixe desativado.
# TIKTOK_EXTENDED_GIFT_INFO=false

# --- App de IA (/ai) -------------------------------------------------------
# Chave do gateway Experiential (https://api.experientiallabs.ai). Sem ela o
# app de IA fica desativado. Crie em https://platform.experientiallabs.ai/settings/api-keys
# e configure no serviço: nunca no Git, nunca no navegador.
# EXPERIENTIAL_API_KEY=
# Modelos usados pelo app (opcional).
# AI_BASE_URL=https://api.experientiallabs.ai/v1
# AI_CHAT_MODEL=gpt-6-luna
# AI_IMAGE_MODEL=gemini-3.1-flash-image
# Pasta que o agente de código pode mexer (padrão: a raiz do projeto).
# AI_WORKSPACE_ROOT=
# Comando de teste que o painel de IA executa.
# AI_TEST_COMMAND=npm test
# AI_TIMEOUT_MS=120000
# AI_MAX_AGENT_STEPS=12
